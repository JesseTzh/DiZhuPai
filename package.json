{
  "name": "dizhupai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Colorfigures 风格的双人斗地主游戏，含电脑对战与金币转账动画",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/export-cards.mjs && node scripts/build.mjs",
    "assets:cards": "node scripts/export-cards.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:entry": "node tests/entry-browser.mjs",
    "test:interactions": "node tests/interactions-browser.mjs",
    "test:home": "node tests/home-browser.mjs",
    "test:save": "node tests/save-browser.mjs",
    "test:shop": "node tests/shop-browser.mjs",
    "test:pages": "node tests/ui-pages.mjs",
    "test:performance": "node tests/performance-browser.mjs",
    "report:video": "node scripts/video-report.mjs",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10"
  }
}
